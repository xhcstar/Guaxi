{
  "version": 1,
  "extensions": [
    {
      "id": "ms-pyright.pyright",
      "display_name": "Pyright",
      "description": "Python language intelligence powered by Microsoft's Pyright language server.",
      "open_vsx": "ms-pyright.pyright",
      "vscode_marketplace": "ms-pyright.pyright",
      "languages": ["python"],
      "compatibility_level": "A",
      "recommended": true,
      "lsp": {
        "server_id": "pyright",
        "runtime": "node_binary",
        "bin_name": "pyright-langserver",
        "args": ["--stdio"],
        "entry_paths": [
          "node_modules/pyright/langserver.index.js",
          "dist/pyright-langserver.js",
          "dist/server.js"
        ],
        "resolve_order": ["extension_bin", "shared_node_runtime", "extension_entry", "downloadable_server"],
        "fallback_server": "pyright",
        "fallback_bin_name": "pyright-langserver"
      }
    },
    {
      "id": "guaxi.typescript-language-server",
      "display_name": "TypeScript and JavaScript Language Features",
