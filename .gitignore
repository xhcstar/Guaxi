# Generated runtime assets (do not commit)
src-tauri/utils/MarkdownConvertor/
src-tauri/utils/Models/surya_models/
# Tectonic 预热缓存（bundles + formats，约 80MB），由开发机预热后随 release 分包
src-tauri/utils/tectonic_cache/

# Generated runtime assets (do not commit)
src-tauri/utils/MarkdownConvertor/*
src-tauri/utils/Models/surya_models/*
src-tauri/utils/Models/whisper_models/*
src-tauri/utils/Models/tts/*
src-tauri/utils/Models/asr/sense-voice/*
# 语音库化后新增：whisper ONNX 模型、VAD 模型与标点模型，均由 tools/fetch_sherpa_onnx_libs.mjs 下载
src-tauri/utils/Models/whisper_onnx/*
src-tauri/utils/Models/vad/*
src-tauri/utils/Models/punctuation/*
src-tauri/utils/Models/translate/*
src-tauri/utils/python_runtime/*
src-tauri/utils/convert_provision.json
src-tauri/utils/Models/embedding/*

# PDFium 运行时库（tools/fetch_pdfium.mjs 构建前下载）
src-tauri/libs/

# sherpa-onnx 原生库归档与下载暂存（约 118MB，由 tools/fetch_sherpa_onnx_libs.mjs 预取，
# 构建时经 SHERPA_ONNX_ARCHIVE_DIR 指向它，避免 build.rs 联网下载）
src-tauri/.sherpa-onnx-libs/
src-tauri/.sherpa-download-tmp/

# Generated python libs (do not commit)
src-tauri/utils/python_libs/*

# Generated bundled resource archives (do not commit)
src-tauri/utils/utils.zip
src-tauri/utils/__bundles/*
!src-tauri/utils/__bundles/.gitkeep

# 图表预览单文件产物（do not commit）
# 由 tools/build_chart_preview_bundle.mjs 用 Vite/esbuild 压缩生成，Rust 侧 include_str! 内联。
# 不同 Node/工具链环境压缩出的短变量名不同（内容语义等价、字节级不同），多台机器交替
# 构建会互相覆盖工作区；它又是构建前必然会生成的东西，因此不进版本库。
# 缺失时 src-tauri/build.rs 会调用 node 补生成。
src-tauri/assets/vendor/guaxi-chart-preview.js

# RSSHub 由 tools/prepare_rsshub_env.mjs 克隆+构建（含自己的 .git/node_modules/dist），不入库
src-tauri/utils/rsshub/

.workbuddy/*

# Local tool state, caches, and environment files (never commit)
.agents/
.bookshelf-preview/
.cache/
.claude/
.codewhale/
.deepseek/
.feeds-preview/
.readpos-preview/
.trae/
.vscode/
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# 发布打包产物（tools/package_release.ps1 与 CI 生成）
release-assets/
release-payload/
release-notes.md
src-tauri/utils/SlidevEnv/NodeJS-LICENSE.txt
