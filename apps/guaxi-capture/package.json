{
  "name": "guaxi-capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node ../../node_modules/vite/bin/vite.js build",
    "preview": "node ../../node_modules/vite/bin/vite.js preview",
    "tauri": "node ../../node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "node ../../node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "node ../../node_modules/@tauri-apps/cli/tauri.js build",
    "android:init": "node ../../node_modules/@tauri-apps/cli/tauri.js android init",
    "android:init:ci": "node ../../node_modules/@tauri-apps/cli/tauri.js android init --ci",
    "android:dev": "node ../../node_modules/@tauri-apps/cli/tauri.js android dev",
    "android:build": "node ../../node_modules/@tauri-apps/cli/tauri.js android build",
    "android:build:ci": "node ../../node_modules/@tauri-apps/cli/tauri.js android build --ci",
    "android:gradle:mirror": "node scripts/run-android-gradle-config.mjs",
    "android:gradle:official": "node scripts/run-android-gradle-config.mjs --base-url https://services.gradle.org/distributions",
    "ios:init": "node ../../node_modules/@tauri-apps/cli/tauri.js ios init",
    "ios:init:ci": "node ../../node_modules/@tauri-apps/cli/tauri.js ios init --ci",
    "ios:dev": "node ../../node_modules/@tauri-apps/cli/tauri.js ios dev",
    "ios:build": "node ../../node_modules/@tauri-apps/cli/tauri.js ios build",
    "ios:build:ci": "node ../../node_modules/@tauri-apps/cli/tauri.js ios build --ci",
    "mobile:check": "powershell -ExecutionPolicy Bypass -File scripts/check-mobile-env.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "vite": "^6.0.3"
  }
}
